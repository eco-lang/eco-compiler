module FlateNativeTest exposing (main)

{-| `folkertdev/elm-flate` inflates raw deflate, zlib and gzip data, and a stored (level 0)
stream, to the same bytes on the native and JS backends. eco's native `Bitwise` is 64-bit
where elm/core's is 32-bit (CGEN_085), and the eco compiler unpacks package archives with this
package (plans/compiler-io-on-eco-system.md D4, P0). The fixtures are Python `zlib`/`gzip`
output of 15537 bytes of Elm-like words; the check is the length and the byte sum modulo
1000003.
-}

-- CHECK: raw: 15537 321919
-- CHECK: zlib: 15537 321919
-- CHECK: gzip: 15537 321919
-- CHECK: stored: 1000 84209
-- EXIT: 0

import Bytes exposing (Bytes)
import Bytes.Decode as Decode
import Bytes.Encode as Encode
import Flate
import Stream
import System


{-| The bytes the hexadecimal text spells.
-}
fromHex : String -> Bytes
fromHex text =
    let
        digit c =
            if Char.isDigit c then
                Char.toCode c - 48

            else
                Char.toCode c - 87

        pairs chars =
            case chars of
                hi :: lo :: rest ->
                    Encode.unsignedInt8 (digit hi * 16 + digit lo) :: pairs rest

                _ ->
                    []
    in
    Encode.encode (Encode.sequence (pairs (String.toList text)))


{-| The length and the byte sum modulo 1000003 of the inflated bytes, or "failed".
-}
summary : Maybe Bytes -> String
summary result =
    case result of
        Nothing ->
            "failed"

        Just bytes ->
            let
                width =
                    Bytes.width bytes

                total =
                    Decode.decode
                        (Decode.loop ( width, 0 )
                            (\( n, acc ) ->
                                if n == 0 then
                                    Decode.succeed (Decode.Done acc)

                                else
                                    Decode.unsignedInt8 |> Decode.map (\b -> Decode.Loop ( n - 1, modBy 1000003 (acc + b) ))
                            )
                        )
                        bytes
                        |> Maybe.withDefault -1
            in
            String.fromInt width ++ " " ++ String.fromInt total


main : Platform.Program System.Environment () ()
main =
    System.simpleProgram
        (\env ->
            Stream.logLine
                (String.join "\n"
                    [ "raw: " ++ summary (Flate.inflate rawDeflate)
                    , "zlib: " ++ summary (Flate.inflateZlib zlibWrapped)
                    , "gzip: " ++ summary (Flate.inflateGZip gzipWrapped)
                    , "stored: " ++ summary (Flate.inflate stored)
                    ]
                )
                env.stdout
        )


