module Tensor.Internal.Support exposing (refused)

{-| Generated by scripts/gen_support.py from the probe of MAX 26.7.0 on CPU
(capi/scripts/inventory/support_probe.py): the primitives, by their public names, that MAX
refuses to compile for a dtype. Everything else probed compiles.
-}

import Tensor.Internal.Prim exposing (DT(..))


refused : String -> DT -> Bool
refused name dt =
    case ( name, dt ) of
        ( "negate", UI64 ) ->
            True

        ( "negate", UI8 ) ->
            True

        _ ->
            False
