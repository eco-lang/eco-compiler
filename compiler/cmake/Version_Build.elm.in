module Compiler.Elm.Version_Build exposing (userFacing)

{-| Build-time-injected user-facing version string.

Generated by CMake into the build tree (`build/compiler/version/`) from `version.txt` plus the
git commit (`-dev-<hash>[-dirty]`, for dev builds), or from `-DECO_VERSION_OVERRIDE=...` (for
tagged releases). The checked-in baseline that plain compiles use lives in
`compiler/src-version/Compiler/Elm/Version_Build.elm`.

@docs userFacing

-}


{-| The user-facing version string for this build.
-}
userFacing : String
userFacing =
    "@ECO_VERSION_USER_FACING@"
