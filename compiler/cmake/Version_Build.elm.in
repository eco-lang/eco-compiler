module Compiler.Elm.Version_Build exposing (userFacing)

{-| Build-time-injected user-facing version string.

Generated by CMake from `version.txt` (the baseline) plus `git describe`
(for dev builds) or the `ECO_VERSION_OVERRIDE` cache variable (for tagged
releases). Do not edit this file directly — edits will be overwritten on
the next configure.

See `plans/release-snagging.md` Step 5 for the wiring.
-}


userFacing : String
userFacing =
    "@ECO_VERSION_USER_FACING@"
