{
    "type": "package",
    "name": "the-sett/elm-mlir",
    "summary": "Build MLIR programs in Elm and write them as MLIR text or bytecode",
    "license": "BSD-3-Clause",
    "version": "1.0.0",
    "exposed-modules": [
        "Mlir.Mlir",
        "Mlir.Loc",
        "Mlir.Pretty",
        "Mlir.Bytecode.StreamEncode"
    ],
    "elm-version": "0.19.0 <= v < 0.20.0",
    "dependencies": {
        "elm/bytes": "1.0.8 <= v < 2.0.0",
        "elm/core": "1.0.5 <= v < 2.0.0",
        "j-maas/elm-ordered-containers": "1.0.0 <= v < 2.0.0"
    },
    "test-dependencies": {
        "elm-explorations/test": "2.0.0 <= v < 3.0.0"
    }
}
