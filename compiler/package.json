{
  "name": "eco",
  "version": "1.0.0-alpha",
  "description": "Eco is a compiler for Elm, targetting native execution.",
  "author": "Rupert Smith",
  "license": "BSD-3-Clause",
  "bin": {
    "guida": "bin/index.js"
  },
  "scripts": {
    "test": "../build/toolchain/bin/elm-test-rs --project ../build/compiler/build-xhr --compiler scripts/elm-stock-post-processed --fuzz 10",
    "review": "elm-review --compiler ../build/toolchain/bin/elm --elm-format-path ../build/toolchain/bin/elm-format",
    "review:fix": "elm-review --compiler ../build/toolchain/bin/elm --elm-format-path ../build/toolchain/bin/elm-format --fix-all",
    "docs": "PATH=$PWD/../build/toolchain/bin:$PATH elm-doc-preview",
    "format": "../build/toolchain/bin/elm-format --yes src tests",
    "format:check": "../build/toolchain/bin/elm-format --validate src tests",
    "watch": "onchange \"src/**/*.elm\" -- sh scripts/build.sh bin"
  },
  "dependencies": {
    "tmp": "^0.2.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "elm-doc-preview": "^6.0.1",
    "elm-review": "^2.13.2",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "onchange": "^7.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
