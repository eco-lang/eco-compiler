{
  "name": "eco",
  "version": "1.0.0-alpha",
  "description": "Eco is a compiler for Elm, targetting native execution.",
  "author": "Rupert Smith",
  "license": "BSD-3-Clause",
  "bin": {
    "guida": "bin/index.js"
  },
  "scripts": {
    "test": "../build/toolchain/bin/elm-test-rs --project ../build/compiler/build-xhr --fuzz 10",
    "watch": "onchange \"src/**/*.elm\" -- ../build/toolchain/bin/elm make --output=../build/compiler/build-xhr/bin/guida.js src/Terminal/Main.elm"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "form-data": "^4.0.2",
    "mock-xmlhttprequest": "^8.4.1",
    "tmp": "^0.2.3",
    "which": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.23.0",
    "elm-review": "^2.13.2",
    "eslint": "^9.23.0",
    "globals": "^16.0.0",
    "onchange": "^7.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
