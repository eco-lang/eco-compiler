# The versions eco builds against: the only place they are written. Change them with
# scripts/deps.sh (it also re-locks deps/max/ and checks MAX's LLVM pin), not by hand.
#
# Plain KEY=VALUE lines, no quotes or spaces, so that sh (`. deps/versions.env`), CMake
# (cmake/EcoVersions.cmake), GitHub Actions (`cat deps/versions.env >> "$GITHUB_ENV"`) and
# PowerShell can all read it. Comments are whole lines.

# Modular MAX, from PyPI (the `max` wheel; deps/max/ is its uv project and lock).
MAX_VERSION=26.7.0

# The llvm-project commit eco's LLVM/MLIR is built from (40 hex digits, never a tag).
# LLVM_FOLLOWS=max: LLVM_COMMIT is MAX_VERSION's own pin (modular/modular,
# bazel/public-patches/llvm_source.bzl at max/v<MAX_VERSION>), so eco and MAX share one LLVM;
# `scripts/deps.sh check` enforces it. LLVM_FOLLOWS=independent: LLVM_COMMIT is set by hand.
# LLVM_DESCRIBE is what `llvm-config --version` reports, for messages and docs only.
LLVM_FOLLOWS=max
LLVM_COMMIT=8d4fc8f1d17e64e1826346a0230a87b50ec371e4
LLVM_DESCRIBE=24.0.0git

# The tools that fetch MAX: uv, and the Python the wheel is installed for (uv fetches it when the
# host has no such Python).
UV_VERSION=0.13.5
PYTHON_VERSION=3.11
