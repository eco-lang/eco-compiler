{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20 },
  "configurePresets": [
    {
      "name": "ninja-clang-lld-linux",
      "displayName": "Ninja + Clang + lld (Linux/macOS LLVM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -UNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -UNDEBUG"
      }
    },
    {
      "name": "ninja-clang-lld-linux-debug",
      "displayName": "Ninja + Clang + lld (Linux/macOS LLVM)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "ninja-clang-lld-linux-ccache",
      "displayName": "Ninja + Clang + lld + ccache (Linux)",
      "inherits": "ninja-clang-lld-linux",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "ninja-clang-lld-linux-debug-ccache",
      "displayName": "Ninja + Clang + lld + ccache (Linux Debug)",
      "inherits": "ninja-clang-lld-linux-debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER_LAUNCHER": "ccache",
        "CMAKE_CXX_COMPILER_LAUNCHER": "ccache"
      }
    },
    {
      "name": "ninja-clang-lld-linux-profile",
      "displayName": "Ninja + Clang + lld (Linux, Profile)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-profile",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS": "-fno-omit-frame-pointer -mno-omit-leaf-frame-pointer",
        "CMAKE_CXX_FLAGS": "-fno-omit-frame-pointer -mno-omit-leaf-frame-pointer"
      }
    },
    {
      "name": "ninja-clang-lld-linux-musl",
      "displayName": "Ninja + Clang + libc++ + lld (Alpine MUSL static — Stage B)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-static",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_INIT": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-static -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++abi -fuse-ld=lld",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -g -UNDEBUG",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -g -UNDEBUG",
        "CMAKE_PREFIX_PATH": "/opt/llvm-mlir",
        "LLVM_INSTALL_PREFIX": "/opt/llvm-mlir",
        "ECO_STATIC": "ON",
        "ECO_STATIC_MUSL": "ON",
        "ECO_LINK_WITH_BFD": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "build",
      "configurePreset": "ninja-clang-lld-linux",
      "jobs": 0
    },
    {
      "name": "debug",
      "configurePreset": "ninja-clang-lld-linux-debug",
      "jobs": 0
    },
    {
      "name": "profile",
      "configurePreset": "ninja-clang-lld-linux-profile",
      "jobs": 0
    },
    {
      "name": "musl",
      "configurePreset": "ninja-clang-lld-linux-musl",
      "jobs": 0
    }
  ]
}
