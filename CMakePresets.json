{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 20 },
  "configurePresets": [
    {
      "name": "dev",
      "displayName": "Dev (Debug build, full assertions + stats + kernel tracing)",
      "description": "Inner-dev-loop preset. -O0 -g, ECO_GC_DEBUG, ECO_KERNEL_DEBUG, GC stats all ON. Slow runtime; fastest iteration on diagnostics.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/debug",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_BUILD_TYPE": "Debug",
        "ECO_KERNEL_DEBUG": "ON"
      }
    },
    {
      "name": "build",
      "displayName": "Build (RelWithDebInfo — the bootstrap target's home)",
      "description": "Default everyday build. -O2 -g -UNDEBUG, asserts ON, GC stats ON, ECO_KERNEL_DEBUG OFF. Hosts the bootstrap chain and the eco-quick fast-iteration target.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_SHARED_LINKER_FLAGS_INIT": "-fuse-ld=lld",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_C_FLAGS_RELWITHDEBINFO": "-O2 -g -UNDEBUG",
        "CMAKE_CXX_FLAGS_RELWITHDEBINFO": "-O2 -g -UNDEBUG"
      }
    },
    {
      "name": "mac-frontend",
      "displayName": "Mac front-end only (bootstrap stages 1-5, no native backend)",
      "description": "Configures only compiler/ via ECO_FRONTEND_ONLY. Pure Node/Elm bootstrap through Stage 5 (eco-compiler.mlir); no LLVM/MLIR, runtime, kernels or tests. See plans/build-on-mac.md.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "ECO_FRONTEND_ONLY": "ON"
      }
    },
    {
      "name": "release",
      "displayName": "Release (static musl — shippable binary)",
      "description": "Stage B static musl build. -O2 -DNDEBUG, no debug syms, no asserts, GC stats OFF, kernel-debug OFF, --strip-all on the final link.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-static",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_INIT": "-stdlib=libc++",
        "CMAKE_EXE_LINKER_FLAGS_INIT": "-static -stdlib=libc++ -rtlib=compiler-rt -unwindlib=libunwind -lc++abi -fuse-ld=lld",
        "CMAKE_C_FLAGS_RELEASE": "-O2 -DNDEBUG -march=x86-64-v3 -mtune=generic",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2 -DNDEBUG -march=x86-64-v3 -mtune=generic",
        "CMAKE_PREFIX_PATH": "/opt/llvm-mlir",
        "LLVM_INSTALL_PREFIX": "/opt/llvm-mlir",
        "ECO_STATIC": "ON",
        "ECO_STATIC_MUSL": "ON",
        "ECO_LINK_WITH_BFD": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "jobs": 0
    },
    {
      "name": "build",
      "configurePreset": "build",
      "jobs": 0
    },
    {
      "name": "mac-frontend",
      "configurePreset": "mac-frontend",
      "jobs": 0
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 0
    }
  ]
}
