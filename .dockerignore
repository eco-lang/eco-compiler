# Build directories
build/
build-static/
debug/
build-profile/

# Caches and profiling output — never needed in a build context, and large
# (.ccache and heap-profiles alone were ~1 GB of the context before this).
.ccache/
# linux-aot bundle job: the host side of the BuildKit ccache mount
# (buildkit-cache-dance), and the bundles "Export distribution bundles" writes.
# Both change between that job's docker builds, so leaving them in the context
# broke the `COPY . .` layer cache and made "Verify fully-static eco binary"
# rebuild eco from scratch (~36 min).
ccache-bundle/
dist/
.pnpm-store/
heap-profiles/
.serena/

# Git directory and metadata
.git/
.gitignore

# Build artifacts
*.o
*.a
*.so
*.dylib

# Elm compiler package-artifact caches (eco-kernel-cpp/{,typed-}artifacts.dat).
# These are in-tree and gitignored; excluding them keeps a host build's stale
# caches from leaking into the Docker build context via `COPY . .`.
*.dat

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# Docker files themselves
Dockerfile
.dockerignore

# Documentation and plans (not needed for build)
*.md
plans/

# Claude Code directory
.claude/
