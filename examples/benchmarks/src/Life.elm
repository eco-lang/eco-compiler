bench : Int -> Bool
bench n =
    let
        population =
            Set.size (generations n rPentomino)

        expected =
            if n >= 1103 then
                Just 116

            else
                String.split "," (String.filter (\c -> c /= '\n') populations)
                    |> List.drop n
                    |> List.head
                    |> Maybe.andThen String.toInt
    in
    expected == Just population
