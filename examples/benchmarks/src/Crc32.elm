module Crc32 exposing (bench, crc)

{-| CRC-32 (the zlib/PNG checksum, polynomial 0xEDB88320), table-driven, over `n` generated bytes
held in a `List Int`: per byte a `Bitwise.xor`, `and`, `shiftRightZfBy` and an `Array.get` of
the 256-entry table. (The bytes are a list rather than `Bytes` to keep this a `Bitwise` test.)

Written to give the same result whether `Bitwise` works on 32 bits (elm/core) or 64 (eco's
native backend): every value it shifts or indexes with is in `0 .. 2^32 - 1`, and the result is
normalised with `modBy 2^32`. Every run checks the standard check value, `CRC32("123456789") =
0xCBF43926`, and at the sizes in `known` the CRC must match Python's `zlib.crc32` of the same
bytes.

-}

import Array exposing (Array)
import Bitwise


table : Array Int
table =
    Array.initialize 256
        (\n ->
            List.foldl
                (\_ c ->
                    if Bitwise.and c 1 /= 0 then
                        modBy 4294967296 (Bitwise.xor 0xEDB88320 (Bitwise.shiftRightZfBy 1 c))

                    else
                        Bitwise.shiftRightZfBy 1 c
                )
                n
                (List.range 1 8)
        )


crc : List Int -> Int
crc bytes =
    let
        step b c =
            modBy 4294967296
                (Bitwise.xor (Bitwise.shiftRightZfBy 8 c)
                    (Maybe.withDefault 0 (Array.get (Bitwise.and 0xFF (Bitwise.xor c b)) table))
                )
    in
    modBy 4294967296 (Bitwise.xor 0xFFFFFFFF (List.foldl step 0xFFFFFFFF bytes))


input : Int -> List Int
input n =
    List.map (\i -> modBy 256 (i * 7919 + (i // 256) * 31 + 17)) (List.range 0 (n - 1))


{-| `( n, CRC-32 of bytes n )`, from Python's `zlib.crc32`.
-}
known : List ( Int, Int )
known =
    [ ( 10000, 3938912822 ), ( 1000000, 1460496007 ) ]


bench : Int -> Bool
bench n =
    let
        result =
            crc (input n)

        matchesKnown =
            case List.filter (\( size, _ ) -> size == n) known of
                ( _, expected ) :: _ ->
                    result == expected

                [] ->
                    True
    in
    crc (List.map Char.toCode (String.toList "123456789")) == 0xCBF43926 && matchesKnown
