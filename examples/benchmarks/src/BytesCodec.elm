module BytesCodec exposing (benchDynamic, benchStatic)

{-| Encode `n` generated bytes with `Encode.sequence (List.map Encode.unsignedInt8 ...)`, then
decode them back with a count loop, `Decode.loop` over `Decode.unsignedInt8`. Two workloads do
the same work:

  - `bytes-static` decodes with a decoder whose whole structure is known at compile time, which
    eco compiles into one fused loop (`design_docs/invariants.csv`, BFUSE_001).
  - `bytes-dynamic` chooses its item decoder at run time, so eco cannot resolve it and runs the
    general decoder (BFUSE_002). The official Elm compiler treats the two alike.

Bytes are the shape eco's decoder fusion supports today; it does not yet fuse loops over wider
reads, or records of them (`test/elm-bytes/src/BytesLoopFusionShapesTest.elm`).

The decoded list must equal the generated one exactly, and the buffer must be `n` bytes long,
at every size.

-}

import Bytes exposing (Bytes)
import Bytes.Decode as Decode exposing (Decoder, Step(..))
import Bytes.Encode as Encode


values : Int -> List Int
values n =
    List.map (\i -> modBy 256 (i * 31 + 7)) (List.range 0 (n - 1))


encode : List Int -> Bytes
encode xs =
    Encode.encode (Encode.sequence (List.map Encode.unsignedInt8 xs))


decodeStatic : Int -> Bytes -> Maybe (List Int)
decodeStatic n bytes =
    Decode.decode
        (Decode.loop ( n, [] )
            (\( left, acc ) ->
                if left <= 0 then
                    Decode.succeed (Done (List.reverse acc))

                else
                    Decode.map (\x -> Loop ( left - 1, x :: acc )) Decode.unsignedInt8
            )
        )
        bytes


decodeDynamic : Decoder Int -> Int -> Bytes -> Maybe (List Int)
decodeDynamic each n bytes =
    Decode.decode
        (Decode.loop ( n, [] )
            (\( left, acc ) ->
                if left <= 0 then
                    Decode.succeed (Done (List.reverse acc))

                else
                    Decode.map (\x -> Loop ( left - 1, x :: acc )) each
            )
        )
        bytes


check : Int -> List Int -> Bytes -> Maybe (List Int) -> Bool
check n xs bytes decoded =
    Bytes.width bytes == n && decoded == Just xs


benchStatic : Int -> Bool
benchStatic n =
    let
        xs =
            values n

        bytes =
            encode xs
    in
    check n xs bytes (decodeStatic n bytes)


benchDynamic : Int -> Bool
benchDynamic n =
    let
        xs =
            values n

        bytes =
            encode xs

        -- Never the second decoder, but the compiler cannot know that.
        each =
            if n >= 0 then
                Decode.unsignedInt8

            else
                Decode.map (\x -> 255 - x) Decode.unsignedInt8
    in
    check n xs bytes (decodeDynamic each n bytes)
