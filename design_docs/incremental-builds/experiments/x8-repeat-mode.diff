 -}
 run : List String -> Flags -> Task Never ()
-run paths ((Flags flagsData) as flags) =
+run paths flags =
+    Utils.envLookupEnv "ECO_EXP_REPEAT"
+        |> Task.andThen
+            (\maybeN ->
+                case Maybe.andThen String.toInt maybeN of
+                    Just n ->
+                        x8Setup n (\retain -> runOnce retain paths flags)
