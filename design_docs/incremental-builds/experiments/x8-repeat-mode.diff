+
+-- ====== X8 EXPERIMENT: REPEAT MODE (env-gated, default off) ======
+
+
+{-| ECO\_EXP\_REPEAT=N runs the same make N times in one process.
+ECO\_EXP\_REPEAT\_GC=1 asks for a full release (Eco.GC.majorGC) after each
+build; otherwise a minor collection is used only to read the report.
+ECO\_EXP\_REPEAT\_EDIT=path rewrites that file before each build, replacing
+the marker X8ITER0 with X8ITER<i>.
+-}
+x8Setup : Int -> (X8Retain -> Task Never ()) -> Task Never ()
+x8Setup n onceWith =
+    Utils.envLookupEnv "ECO_EXP_RETAIN"
+        |> Task.andThen
+            (\retainFlag ->
+                if retainFlag == Just "1" || retainFlag == Just "2" then
+                    Utils.newMVar (\_ -> Bytes.Encode.unsignedInt8 0) Nothing
+                        |> Task.andThen (\mv -> x8Setup2 n (onceWith (Just ( retainFlag == Just "2", mv ))))
+
+                else
+                    x8Setup2 n (onceWith Nothing)
+            )
+
+
+{-| ECO\_EXP\_RETAIN=1 (repeat mode only): keep the latest build's Details and
+Artifacts alive in a native MVar until the next build replaces them, as a
+server that retains type-checked state would.
+-}
+type alias X8Retain =
+    Maybe ( Bool, IO.MVar (Maybe ( Details.Details, Build.Artifacts, Maybe Generate.MergedTypedData )) )
+
+
+x8RetainStore : X8Retain -> Details.Details -> Build.Artifacts -> Task x ()
+x8RetainStore retain details artifacts =
+    case retain of
+        Nothing ->
+            Task.succeed ()
+
+        Just ( _, mv ) ->
+            Task.io
+                (Utils.takeMVar (Bytes.Decode.fail) mv
+                    |> Task.andThen (\_ -> Utils.putMVar (\_ -> Bytes.Encode.unsignedInt8 0) mv (Just ( details, artifacts, Nothing )))
+                )
+
+
+{-| ECO\_EXP\_RETAIN=2: after the build's output is written, drop the previous
+build's retained typed program and load + keep this build's (the merged
+TOpt.GlobalGraph + GlobalTypeEnv that monomorphization starts from).
+-}
+x8RetainTyped : BuildContext -> Build.Artifacts -> Task Exit.Make ()
+x8RetainTyped ctx artifacts =
+    case ctx.retain of
+        Just ( True, mv ) ->
+            Task.io (Utils.takeMVar Bytes.Decode.fail mv)
+                |> Task.andThen (\_ -> Task.io Time.now)
+                |> Task.andThen
+                    (\t0 ->
+                        Generate.x8LoadMerged ctx.root ctx.maybeBuildDir ctx.localPackage ctx.details artifacts
+                            |> Task.mapError Exit.MakeBadGenerate
+                            |> Task.andThen
+                                (\merged ->
+                                    Task.io Time.now
+                                        |> Task.andThen
+                                            (\t1 ->
+                                                Task.io (IO.writeLn IO.stderr ("[x8] retain-load ms=" ++ String.fromInt (Time.posixToMillis t1 - Time.posixToMillis t0)))
+                                            )
+                                        |> Task.andThen (\_ -> Task.io (Utils.putMVar (\_ -> Bytes.Encode.unsignedInt8 0) mv (Just ( ctx.details, artifacts, Just merged ))))
+                                )
+                    )
+
+        _ ->
+            Task.succeed ()
+
+
+x8Setup2 : Int -> Task Never () -> Task Never ()
+x8Setup2 n once =
+    Utils.envLookupEnv "ECO_EXP_REPEAT_GC"
+        |> Task.andThen
+            (\gcFlag ->
+                Utils.envLookupEnv "ECO_EXP_REPEAT_EDIT"
+                    |> Task.andThen
+                        (\editPath ->
+                            case editPath of
+                                Just path ->
+                                    File.readUtf8 path
+                                        |> Task.andThen
+                                            (\content ->
+                                                x8Loop (gcFlag == Just "1") (Just ( path, content )) n 1 once
+                                            )
+
+                                Nothing ->
+                                    x8Loop (gcFlag == Just "1") Nothing n 1 once
+                        )
+            )
+
+
+x8Loop : Bool -> Maybe ( String, String ) -> Int -> Int -> Task Never () -> Task Never ()
+x8Loop doMajor edit n i once =
+    if i > n then
+        Task.io Eco.GC.majorGC
+            |> Task.andThen (\r -> IO.writeLn IO.stderr (GcPoints.render "x8-final" r))
+
+    else
+        let
+            editTask =
+                case edit of
+                    Just ( path, content ) ->
+                        File.writeUtf8 path (String.replace "X8ITER0" ("X8ITER" ++ String.fromInt i) content)
+
+                    Nothing ->
+                        Task.succeed ()
+        in
+        editTask
+            |> Task.andThen (\_ -> Time.now)
+            |> Task.andThen
+                (\t0 ->
+                    IO.writeLn IO.stderr ("[x8] begin iter=" ++ String.fromInt i ++ " epoch_ms=" ++ String.fromInt (Time.posixToMillis t0))
+                        |> Task.andThen (\_ -> once)
+                        |> Task.andThen (\_ -> Time.now)
+                        |> Task.andThen
+                            (\t1 ->
+                                IO.writeLn IO.stderr
+                                    ("[x8] end iter="
+                                        ++ String.fromInt i
+                                        ++ " epoch_ms="
+                                        ++ String.fromInt (Time.posixToMillis t1)
+                                        ++ " wall_ms="
+                                        ++ String.fromInt (Time.posixToMillis t1 - Time.posixToMillis t0)
+                                    )
+                            )
+                )
+            |> Task.andThen
+                (\_ ->
+                    if doMajor then
+                        Eco.GC.majorGC
+
+                    else
+                        Eco.GC.minorGC
+                )
+            |> Task.andThen (\r -> IO.writeLn IO.stderr (GcPoints.render ("x8-iter-" ++ String.fromInt i) r))
+            |> Task.andThen (\_ -> x8Loop doMajor edit n (i + 1) once)
+
