+    , enq : List ( ( Int, Int ), ( Int, Mono.MonoType ) ) -- ((requester spec | -1, callee spec), (hit code 0 new/1 identical/2 noop join/3 changed join/4 callMemo-hit edge (no enqueue; type = cached UNSTAMPED func type, not a demand), demand type))
