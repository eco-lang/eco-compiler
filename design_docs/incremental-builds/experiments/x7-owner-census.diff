+
+    else
+        s
+
+
+ocDqMulti : Int -> List Int -> S -> S
+ocDqMulti specId mids s =
+    ocUpdate (\c -> { c | dqMulti = ( specId, mids ) :: c.dqMulti }) s
+
+
+ocSigHit : String -> String -> S -> S
+ocSigHit gkey homeMod s =
+    if ocOn s then
+        ocUpdate (\c -> { c | sigHits = ( ocCurSpec s, ( gkey, homeMod ) ) :: c.sigHits }) s
