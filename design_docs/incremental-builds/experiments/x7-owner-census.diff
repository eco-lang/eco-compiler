+    else
+        s
+
+
+ocSigInferred : List String -> S -> S
+ocSigInferred gkeys s =
+    if ocOn s then
+        ocUpdate (\c -> { c | sigBy = List.foldl (\k acc -> CoreDict.insert k (ocCurSpec s) acc) c.sigBy gkeys }) s
+
+    else
+        s
