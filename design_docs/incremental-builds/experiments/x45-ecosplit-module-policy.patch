+++ b/runtime/src/codegen/Passes/ExpModuleOf.h	2026-10-06 10:51:00.913619021 +0000
@@ -0,0 +1,76 @@
+//===- ExpModuleOf.h - incremental-builds experiment helpers ----*- C++ -*-===//
+//
+// EXPERIMENT-ONLY (design_docs/incremental-builds, X3/X4/X5). Not product code.
+//
+// Recovers the Elm source module of a generated symbol from its MLIR name:
+//   <Module_With_Underscores>_<sanitizedName>_$_<specId>[$cap|$clo|...]
+// Module segments are Capitalized; Elm value names start lowercase. A name
+// whose segments are all Capitalized is a constructor function: the last
+// segment is the ctor. Lambdas (`<entry>_lambda_<uid>`), local tail functions
+// (`_tail_...`), accessors, wrappers and runtime symbols have no recoverable
+// module and return "" (callers attribute them to a referrer).
+//
+// ECO_EXP_LOCAL_PREFIXES="Compiler,Builder,..." marks which first segments are
+// project modules; with `requester` semantics a symbol in a NON-local (package)
+// module also returns "" so it is attributed to its requester.
+//
+//===----------------------------------------------------------------------===//
+#ifndef ECO_EXP_MODULE_OF_H
+#define ECO_EXP_MODULE_OF_H
+
+#include "llvm/ADT/SmallVector.h"
+#include "llvm/ADT/StringRef.h"
+#include "llvm/ADT/StringSet.h"
+
+#include <cstdlib>
+#include <string>
+
+namespace eco::expx {
+
+inline const llvm::StringSet<> &localPrefixes() {
+    static const llvm::StringSet<> s = [] {
+        llvm::StringSet<> r;
+        if (const char *e = ::getenv("ECO_EXP_LOCAL_PREFIXES")) {
+            llvm::SmallVector<llvm::StringRef, 16> parts;
+            llvm::StringRef(e).split(parts, ',', -1, false);
+            for (auto p : parts)
+                r.insert(p.trim());
+        }
+        return r;
+    }();
+    return s;
+}
+
+/// "" when unknown. With `requester`, package modules also give "".
+inline std::string moduleOfSymbol(llvm::StringRef name, bool requester) {
+    size_t d = name.find("_$_");
+    if (d == llvm::StringRef::npos)
+        return "";
+    llvm::StringRef base = name.substr(0, d);
+    if (base.empty() || base.starts_with("_") || base.starts_with("accessor_"))
+        return "";
+    llvm::SmallVector<llvm::StringRef, 8> toks;
+    base.split(toks, '_', -1, /*KeepEmpty=*/true);
+    size_t k = 0;
+    while (k < toks.size() && !toks[k].empty() &&
+           toks[k][0] >= 'A' && toks[k][0] <= 'Z')
+        ++k;
+    if (k == toks.size())
+        --k; // all Capitalized: constructor function, drop the ctor name
+    if (k == 0)
+        return "";
+    std::string mod;
+    for (size_t i = 0; i < k; ++i) {
+        if (i)
+            mod += '.';
+        mod += toks[i].str();
+    }
+    if (requester && !localPrefixes().empty() &&
+        !localPrefixes().contains(toks[0]))
+        return "";
+    return mod;
+}
+
+} // namespace eco::expx
+
+#endif
